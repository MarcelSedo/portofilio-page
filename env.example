# Contact form  (app/api/contact)
# mock = log only, no email (allowed only outside production)
CONTACT_FORM_MODE=mock

# Needed when CONTACT_FORM_MODE=email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password-here
MAIL_FROM="Portfolio <you@example.com>"
MAIL_TO=you@example.com
# SMTP_TLS_SERVERNAME=
